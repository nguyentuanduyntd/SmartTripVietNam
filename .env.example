# Supabase public API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres connection for Drizzle
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary - server only
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI API key

OPENAI_API_KEY=

OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini - sinh lịch trình sau bước retrieval
GEMINI_API_KEY=

# Có thể đổi model ở một nơi mà không cần sửa source code
GEMINI_MODEL=gemini-3.6-flash

AI_ITINERARY_PROOF_SECRET=  

# Resend - gửi email OTP quên mật khẩu
RESEND_API_KEY=
RESEND_FROM_EMAIL="SmartTrip <onboarding@resend.dev>"

# Secret (pepper) dùng để hash mã OTP trước khi lưu DB, tạo bằng: openssl rand -hex 32
OTP_HASH_SECRET=